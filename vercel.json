{
	"version": 2,
	"builds": [
		{
			"src": "mozio/wsgi.py",
			"use": "@vercel/python",
			"config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
		},
		{
			"src": "build.sh",
			"use": "@vercel/static-build",
			"config": {
				"distDir": "static"
			}
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "mozio/wsgi.py"
		}
	],
	"crons": [
		{
			"path": "/redis-update",
			"schedule": "0 8 * * *"
		}
	]
}
